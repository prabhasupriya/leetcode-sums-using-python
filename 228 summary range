class Solution {
public:
    vector<string> summaryRanges(vector<int>& nums) {
        int n = nums.size();
        vector<string> result;
        if(n ==0){
            return result;
        }
        int end =nums[0];
        int start = nums[0];
        for(int i=1;i<n;i++){
            if(nums[i] == nums[i-1]+1){
                end= nums[i];
            }
            else{
                if(start == end){
                result.push_back(to_string(start));
                }
                else{
            result.push_back(to_string(start)+ "->"+ to_string(end) );
                }  start =end=nums[i];
                
            }
        }
        if(start == end){
    result.push_back(to_string(start));
        }
        else{
    result.push_back(to_string(start) +"->" + to_string(end));
        }

        return result;
    }
};
