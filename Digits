class Solution {
public:
    int evenlyDivides(int n) {
        int temp = n;
        int count = 0;

        while (temp != 0) {
            int d = temp % 10;

            if (d != 0 && n % d == 0) {
                count++;
            }

            temp = temp / 10;   // ✅ always update temp
        }

        return count;
    }
};
