import math

def is_prime(n):
    if n <= 1:
        return False
    for i in range(2, int(math.sqrt(n)) + 1):
        if n % i == 0:
            return False
    return True

n = int(input())
arr = list(map(int, input().split()))

s = 0
count = 0

for x in arr:
    if is_prime(x):
        s += x
        count += 1

if count == 0:
    print("0.00")
else:
    avg = s / count
    print(f"{avg:.2f}")
