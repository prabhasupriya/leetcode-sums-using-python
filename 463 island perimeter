class Solution {
public:
int n,m;
int perimeter =0;
void DFS(vector<vector<int>> grid , int i,int j){
    if(i<0 || j<0 || i >=n || j>=m || grid[i][j] == 0){
        perimeter++;
        return;
    }
    if(grid[i][j]==-1){
        return;
    }
    grid[i][j] =-1;

    DFS(grid , i-1,j);//up
    DFS(grid ,i ,j-1);//left
    DFS(grid ,i+1,j);//down
    DFS(grid ,i,j+1);//right
}
    int islandPerimeter(vector<vector<int>>& grid) {
        int n = grid.size();
        int m = grid[0].size();
        for(int i=0;i<n;i++){
            for(int j =0;j<m;j++){
               if(grid[i][j]== 1){
                    DFS(grid ,i,j);
                    return perimeter;
               }
                
            }
        }
        return perimeter;
    }
};
