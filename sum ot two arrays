#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int n,m;
    cin >> n>> m;
    vector<vector<long long >>  sum (n, vector<long long>(m));
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin >> sum[i][j];
        }
    }
    for(int i =0;i<n;i++){
        for(int j=0;j<m;j++){
            long long x;
            cin >> x;
             sum[i][j] += x;
        }
    }
    for(int i=0;i<n;i++){
        for(int j =0;j<m;j++){
            cout << sum[i][j] << " ";
        }
        cout << endl;
    }
    return 0;
}
