#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int n,m;
    cin >>n>>m;
    vector<vector<int>> count(n, vector<int>(m));
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin >> count[i][j];
        }
    }
    int a;
    cin >> a;
    unordered_set<int> s;
    for(int i=0; i<a;i++){
        int x;
        cin >> x;
        s.insert(x);
    }
    for(int i=0;i<n;i++){
        int count1 =0;
        for(int j=0; j<m;j++){
            if(s.find(count[i][j]) != s.end()){
                count1 ++;
            }
        }
        cout << count1 << endl;
    }
    return 0;
}
