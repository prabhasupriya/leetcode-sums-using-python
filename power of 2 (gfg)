class Solution {
  public:
    bool isPowerofTwo(int n) {
        // code here
        bool found = false;
        for(int i=0;i<=n/2 ; i++){
            if(pow(2,i) == n){
                found=true;
                break;
            }
            else if(pow(2,i) > n){
                found = false;
                break;
            }
            else{
                continue;
            }
        }
        return found;
    }
};
