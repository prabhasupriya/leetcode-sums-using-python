#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
   int n;
   cin >> n;
   vector<vector<int>> a(n,vector<int>(n));
   for(int i =0;i< n;i++){
    for(int j =0; j <n;j++){
        cin >> a[i][j];
    }
   }
   //interchange dagonals 
   for(int i=0;i<n;i++){
    swap(a[i][i] , a[i][n-1-i]);
   }
   for(int i=0;i<n;i++){
    for(int j=0;j<n;j++){
        cout << a[i][j] << " ";
    }
    cout << endl;
   }
    return 0;
}
