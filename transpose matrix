#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int n,m;
    cin >> n>>m;

    vector<vector<long long>> matrix(n,vector<long long>(m));

    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin >> matrix[i][j];
        }
    }
     for(int j=0; j <m; j++){
        for(int i=0 ;i<n;i++){
            cout << matrix[i][j] << " ";
        }
        cout << endl;
     }
    return 0;
}
