#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t>0){
        int n;
        cin>>n;
        vector<int> a(n);
        for(int i=0;i<n;i++){
            cin >> a[i];
        }
        sort(a.begin(),a.end(),greater<int>());
        int max1= a[0];
        int max2;
        for(int i=1;i<n;i++){
            if(max1 != a[i]){
                max2 = a[i];
                break;
            }
        }
        cout << max1+max2 << endl;
        t=t-1;
        // t--;your code goes here
    }
}
