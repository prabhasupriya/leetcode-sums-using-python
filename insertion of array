    int a;
    cin >>a;
    int arr[a];
    for(int i=0;i<a;i++){
        cin >> arr[i];
    }  
    int b;
    cin >> b;
    int brr[b];
    for(int i=0;i<b;i++){
        cin >> brr[i];
    }

    unordered_set<int> p;
    for(int i =0;i<b;i++){
    p.insert(brr[i]);
    }
