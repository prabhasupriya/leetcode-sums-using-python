#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;
    int arr[a];
    int attribut =0;
    int maxattribute =0;
    for(int i =0;i <a;i++){
        cin >> arr[i];
        attribut += arr[i];
        maxattribute = max(attribut , maxattribute);
    }
    cout << maxattribute;
    
    return 0;
}
