#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
   int n;
   cin >> n;
   vector<vector<int>> c(n ,vector<int>(n));
   for(int i=0;i<n;i++){
    for(int j=0;j<n ;j++){
        cin >> c[i][j];
    }
   }

   vector<vector<int>> d(n-2 , vector<int>(n-2));

   for(int i=1;i<n-1;i++){
    for(int j =1;j<n-1;j++){
        int localmax = INT_MIN;

        for(int x = i-1; x<= i+1; x++){
            for(int y = j-1 ; y<= j+1;y++){
                localmax = max(localmax ,c[x][y]);

            }
        }
        d[i-1][j-1] = localmax;
    }
   }

   for(int i=0;i<n-2;i++){
    for(int j=0;j<n-2;j++){
        cout << d[i][j] << " ";
    }
    cout << endl;
   }
    return 0;
}
