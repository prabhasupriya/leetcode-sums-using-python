#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int number;
    cin >>number;
    int digit;
    int temp= number;
    int reverse =0;
    while(temp >0 || temp < 0){
        digit = temp%10;
        reverse = reverse*10 + digit;
        temp /= 10;
    }
    cout << reverse << endl;
    return 0;
}
