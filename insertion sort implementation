#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */
    int a;
    cin >> a;
    vector<int> arr(a);
    for(int i=0;i<a;i++){
        cin >> arr[i];
    }   
    for(int i=1; i<a;i++){
        int key = arr[i];
        int j =i-1;
        while(j >=0 && arr[j] > key ){
            arr[j+1] = arr[j];
            j--;
        }
        arr[j+1] = key;
        for(int k =0 ; k <a;k++){
            cout<<arr[k] << " ";
        }
        cout<< endl;
    }
    return 0;
    
}
