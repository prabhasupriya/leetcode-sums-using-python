#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;
    int arr[a];
    for(int i =0;i<a;i++){
        cin >> arr[i];
    }
    int i=0; 
    //increasing array
    while(i+1< a && arr[i] <arr[i+1]){
        i++;
    }
    while(i+1 < a && arr[i] > arr[i+1]){
        i++;
    }
    if(i == a-1){
        cout << "true";
    }
    else{
        cout <<"false";
    }
    return 0;
}
