#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */ 
    int rows, col;
    cin >> rows >> col;
    vector<int> colsum(col,0);
    for(int i=0;i <rows ;i++){
        for(int j =0;j<col;j++){
            int x;
            cin >> x;
            colsum[j] += x;

        }
    }
    for(int i=0 ; i< col;i++){
        cout << colsum[i] << endl;
    }  
    return 0;
}
