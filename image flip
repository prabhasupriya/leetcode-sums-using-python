#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int n,m;
    cin >> n>>m;
    vector<vector<int>> image(n,vector<int>(m));

    for(int i=0;i<n;i++){
        for(int j=0;j<m; j++){
            cin >> image[i][j];
        }
    }
    //process the each row
    for(int i=0;i<n;i++){
        //flip horiszontally 
        reverse(image[i].begin() , image[i].end());
        //invert the row
        for(int j=0; j<m ;j++){
            image[i][j] = 1- image[i][j];
        }
    }

    for(int i=0;i<n;i++){
        for(int j=0 ;j<m;j++){
            cout << image[i][j] << " ";
        }
        cout<< endl;
    }
    return 0;
}
