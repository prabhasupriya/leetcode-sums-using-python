class Solution {
public:
    int dominantIndices(vector<int>& nums) {
        int count =0;
        for(int i =0;i<nums.size()-1;i++){
        int sum=0;
            int c=0;
            for(int j =i+1;j<nums.size() ; j++){
                sum += nums[j];
                c+=1;
            }
             if(nums[i] > (sum/c)){
                count += 1;
            }
        }
        return count ;
    }
};©leetcode
