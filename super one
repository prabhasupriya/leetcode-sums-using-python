#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int n,m;
    cin >>n>>m;
    vector<vector<int>> matrix(n,vector<int>(m));
    for(int i=0;i<n;i++){
        for(int j=0;j<m;j++){
            cin >> matrix[i][j];
        }
    }
    //directions for 8 neighbours

    int dx[8] = {-1,-1,-1,0,1,1,1};
    int dy[8] = {-1,0,1,-1,1,-1,0,1};
    for(int i=1;i< n-1 ;i++){
        for(int j=1;j< m-1;j++){
            if(matrix[i][j] == 1){
                bool isSuperone = true;
                for(int k=0;k<8;k++){
                    int ni= i + dx[k];
                    int nj = j+dy[k];
                    if(matrix[ni][nj] != 0){
                        isSuperone = false;
                        break;
                    }
                }
                if(isSuperone){
                    cout << "Yes";
                    return 0;
                }

            }
        }
    }
    cout << "No";
    return 0;
}
