#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;
    vector<long long> arr(a);
    for(int i =0; i<a;i++){
        cin >> arr[i];
    }
    sort(arr.begin() , arr.end());
    long long ans = LLONG_MAX;
    for(int i=0; i<a-1 ; i++){
        ans = min(ans , arr[i+1]-arr[i]);
    }
cout<<ans;
    return 0;
}
