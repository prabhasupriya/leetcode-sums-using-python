#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */  
    int a,key;
    cin >> a;
    cin >> key;
    vector<int> arr(a);
    for(int i=0;i<a;i++){
        cin >> arr[i];
    } 
    bool found = false;
    int low =0;
    int high= a-1;
    while(low <= high){
        int mid = (low +high)/2;
        cout << low <<" "<< high <<" " << mid << endl;
        if(arr[mid] == key){
            found = true;
            break;
        }
        else if( arr[mid] < key){
            low =mid+1;
        }
        else{
            high = mid -1;
        }
    }
    if ( found){
        cout << "True";
    }
    else{
        cout << "False";
    }
    return 0;
}
