class Solution {
public:
    int hammingWeight(int n) {
        string binary="";
        int count =0;
        while(n >0){
            binary = binary+to_string(n%2);
            n =n/2;
        }
        for(int i=0;i<binary.size();i++){
            if(binary[i] == '1'){
                count += 1;
            }
        }
        return count ;
    }
};
