#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int n;
    cin >> n;
    long long sum =0;
    for(int i=0; i<n;i++){
        for(int j=0;j<n;j++){
            int x;
            cin >> x;
            if(i >= j){
                sum += x;
            }
        }
    }
    cout << sum;
    return 0;
}
