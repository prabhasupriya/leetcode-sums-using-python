s = input()
s = s.lower().replace(" ", "")

freq = {}

# Count frequency
for c in s:
    freq[c] = freq.get(c, 0) + 1

found = False

# Find first unique character
for c in s:
    if freq[c] == 1:
        print(c)
        found = True
        break

# If no unique character found
if not found:
    print(-1)
