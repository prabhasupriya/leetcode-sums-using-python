#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;
    vector<int> arr(a);
    for(int i=0; i<a;i++){
        cin >> arr[i];
    }
    for(int i=0;i<a-1;i++){
        int minindex = i;
        for(int j = i+1;j<a;j++){
            if(arr[j] < arr[minindex]){
                minindex =j;
            }
        }
        swap(arr[i] , arr[minindex]);
        for(int k =0;k<a;k++){
            cout<< arr[k] << " ";
        }
        cout<< endl;
    }

    return 0;
}
