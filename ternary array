#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;

    long long ans;
    for(int i=0;i<a; i++){
        int x;
        cin >> x;
        long long best = LLONG_MAX;
        for(int i=0;i<=2;i++){
            if(i != x){
                best = min(best , llabs(x-i));
            }
        }
        ans += best;
    }
    cout << ans;
    return 0;
}
