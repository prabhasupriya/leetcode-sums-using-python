#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;
    int total=0;
    vector<int> arr(a);
    for(int i=0;i<a;i++){
        cin >> arr[i];
        total += arr[i];
    }
    if(total % 3 != 0){
        cout << "false";
        return 0;
    }
    long long partsum = total/3;
    long long currentsum =0;
    int count =0;
    for(int i=0 ;i< a-1;i++){
        currentsum += arr[i];
        if(currentsum == partsum){
            count++;
            currentsum=0;
            if(count ==2){
                cout << "true";
                return 0;
            }
        }
    }
   
    cout<< "false";
    return 0;
}
