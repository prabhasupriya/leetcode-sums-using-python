#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin>> a;
    int arr[a];
    for(int i =0;i<a;i++){
        cin>>arr[i];
    }
    int b;
    cin >> b;
    int brr[b];
    for(int i =0;i<b;i++){
        cin >> brr[i];
    }
    for(int i =0 ;i<b;i++){
        if(brr[i]>=a || brr[i]<0){
            cout << -1 <<" ";
        }
        else{
            cout<< arr[brr[i]] << " ";
        }
    }
    return 0;
}
