n = int(input())

# Initialize matrices
a = []
b = []
c = []

# Read matrix A
for i in range(n):
    row = list(map(int, input().split()))
    a.append(row)

# Read matrix B
for i in range(n):
    row = list(map(int, input().split()))
    b.append(row)

# Add matrices
for i in range(n):
    row = []
    for j in range(n):
        row.append(a[i][j] + b[i][j])
    c.append(row)

# Print result matrix
for i in range(n):
    for j in range(n):
        print(c[i][j], end=" ")
    print()
