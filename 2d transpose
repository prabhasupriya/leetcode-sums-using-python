vector<vector<int>> transpose(int a[][M], int n) {
    // n = number of rows
    // M = number of columns

    // Transpose will be M x n
    vector<vector<int>> t(M, vector<int>(n));

    for(int i = 0; i < n; i++) {
        for(int j = 0; j < M; j++) {
            t[j][i] = a[i][j];
        }
    }

    return t;
}
