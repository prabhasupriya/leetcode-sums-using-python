#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >> a;
    int total =0;
    vector<long long> arr(a);
    for(int i=0;i<a;i++){
        cin >> arr[i];
        total += arr[i];
    }
    int leftsum =0;
    for(int i=0;i<a;i++){
        int rigthsum = total - arr[i] - leftsum;
        cout << abs(leftsum - rigthsum) << " ";
        leftsum += arr[i];
    }
    return 0;
}
