class Solution {
public:
    int thirdMax(vector<int>& nums) {
        unordered_set<int> s(nums.begin(), nums.end());
        vector<int> v(s.begin(), s.end());
        sort(v.begin(),v.end(), greater<int>());
        if(v.size() <3){
            return v[0];
        }
        return v[2];
    }
};
