#include <bits/stdc++.h>
using namespace std;

int main() {
    /* Enter your code here. Read input from STDIN. Print output to STDOUT */   
    int a;
    cin >>a;
    vector<int> arr(a);
    for(int i=0;i< a;i++){
        cin >> arr[i];
    }
    for(int i=0;i<a-1 ; i++){
        for(int j =0;j<a-i-1;j++){
            if(arr[j]> arr[j+1]){
                swap(arr[j] , arr[j+1]);
            }
        }
    
    for(int k =0;k<a;k++){
        cout << arr[k] << " ";
    }
    cout <<endl;
    }
    return 0;
}
